---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';

type Props = CollectionEntry<'notes'>['data'] & { wordCount: number; headings: MarkdownHeading[] };

const { title, description, pubDate, updatedDate, heroImage, wordCount, headings } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 1200px;
			}
			.back {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				min-height: 44px;
				margin-bottom: 1.75rem;
				padding: 0 1.125rem 0 0.875rem;
				border-radius: 999px;
				background-color: rgb(229, 233, 240);
				color: rgb(var(--gray-dark));
				font-size: 0.9375rem;
				text-decoration: none;
				transition: 0.2s ease;
			}
			.back:hover {
				background-color: rgb(216, 222, 232);
			}
			.hero-image {
				display: flex;
				justify-content: center;
				margin-bottom: 5rem;
				border-radius: 12px;
				/* 和封面圖邊緣同色，讓圖片保持原比例時左右空白不突兀 */
				background-color: #fbf8ee;
				overflow: hidden;
			}
			.hero-image img {
				display: block;
				width: auto;
				max-width: 100%;
				height: 400px;
				object-fit: contain;
			}
			.layout {
				display: grid;
				grid-template-columns: 220px minmax(0, 860px);
				grid-template-areas:
					'toc title'
					'toc body';
				column-gap: 4rem;
				align-items: start;
			}
			.toc {
				grid-area: toc;
				position: sticky;
				top: 7rem;
			}
			.toc summary {
				display: none;
			}
			.toc h2 {
				margin: 0 0 0.75rem;
				color: rgb(var(--gray));
				font-size: 0.875rem;
				letter-spacing: 0.12em;
			}
			.toc ol {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.toc a {
				display: flex;
				align-items: center;
				min-height: 44px;
				box-sizing: border-box;
				padding: 0.5rem 0.875rem;
				border-radius: 10px;
				background-color: rgb(244, 246, 249);
				color: rgb(var(--gray-dark));
				font-size: 0.9375rem;
				line-height: 1.4;
				text-decoration: none;
				transition: 0.2s ease;
			}
			.toc .depth-3 a {
				padding-left: 1.75rem;
			}
			.toc a[aria-current='true'] {
				background-color: var(--color-primary);
				color: white;
				font-weight: 700;
			}
			.title {
				grid-area: title;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.title h1 {
				margin: 0 0 0.75rem;
				font-size: 2rem;
				font-weight: 700;
				line-height: 1.35;
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.5rem 1.5rem;
				color: rgb(var(--gray));
				font-size: 0.875rem;
			}
			.date,
			.word-count {
				display: flex;
				align-items: center;
				gap: 0.35em;
				margin: 0;
			}
			.last-updated-on {
				font-style: italic;
			}
			.prose {
				grid-area: body;
				color: rgb(var(--gray-dark));
			}
			.prose :global(h2),
			.prose :global(h3) {
				scroll-margin-top: 7rem;
			}
			@media (max-width: 720px) {
				.back {
					margin-bottom: 1rem;
					font-size: 0.875rem;
				}
				.hero-image {
					margin-bottom: 2rem;
				}
				.hero-image img {
					width: 100%;
					height: auto;
				}
				.layout {
					grid-template-columns: minmax(0, 1fr);
					grid-template-areas:
						'title'
						'toc'
						'body';
				}
				.toc {
					position: static;
					margin: 1rem 0 0.75rem;
					border-radius: 12px;
					background-color: white;
					box-shadow: 0 1px 4px rgba(15, 18, 25, 0.12);
					overflow: hidden;
				}
				.toc summary {
					display: flex;
					align-items: center;
					justify-content: space-between;
					min-height: 48px;
					padding: 0 1rem;
					color: rgb(var(--gray-dark));
					font-size: 0.875rem;
					font-weight: 700;
					list-style: none;
					cursor: pointer;
				}
				.toc summary::-webkit-details-marker {
					display: none;
				}
				.toc summary svg {
					transition: 0.2s ease;
				}
				.toc[open] summary svg {
					transform: rotate(180deg);
				}
				.toc h2 {
					display: none;
				}
				.toc ol {
					gap: 0.375rem;
					padding: 0 0.625rem 0.75rem;
				}
				.toc a {
					font-size: 0.875rem;
				}
				.title {
					padding-bottom: 0.75rem;
				}
				.title h1 {
					margin: 0 0 0.5rem;
					font-size: 1.375rem;
					line-height: 1.4;
				}
				.meta {
					font-size: 0.8125rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<a href="/" class="back">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
				<span>返回列表</span>
			</a>
			<article>
				{heroImage && (
					<div class="hero-image">
						<img src={heroImage} alt="" />
					</div>
				)}
				<div class="layout">
					{headings.length > 0 && (
						<details class="toc" open>
							<summary>
								<span>本文目錄</span>
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
							</summary>
							<nav aria-label="本文目錄">
								<h2>本文目錄</h2>
								<ol>
									{headings.map((heading, index) => (
										<li class={`depth-${heading.depth}`}>
											<a href={`#${heading.slug}`} aria-current={index === 0 ? 'true' : 'false'}>
												{heading.text}
											</a>
										</li>
									))}
								</ol>
							</nav>
						</details>
					)}
					<div class="title">
						<h1>{title}</h1>
						<div class="meta">
							<div class="date">
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 21h8"/><path d="m15 5 4 4"/><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/></svg>
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
							<p class="word-count"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 16H8"/><path d="M14 8H8"/><path d="M16 12H8"/><path d="M4 3a1 1 0 0 1 1-1 1.3 1.3 0 0 1 .7.2l.933.6a1.3 1.3 0 0 0 1.4 0l.934-.6a1.3 1.3 0 0 1 1.4 0l.933.6a1.3 1.3 0 0 0 1.4 0l.933-.6a1.3 1.3 0 0 1 1.4 0l.934.6a1.3 1.3 0 0 0 1.4 0l.933-.6A1.3 1.3 0 0 1 19 2a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1 1.3 1.3 0 0 1-.7-.2l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.934.6a1.3 1.3 0 0 1-1.4 0l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-1.4 0l-.934-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-.7.2 1 1 0 0 1-1-1z"/></svg>共 {wordCount.toLocaleString()} 字</p>
						</div>
					</div>
					<div class="prose">
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<script>
	// 捲動時把目前所在段落對應的目錄按鈕標成選中
	const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
	const targets = links
		.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
		.filter((el): el is HTMLElement => el !== null);

	function updateActive() {
		let current = 0;
		targets.forEach((target, index) => {
			if (target.getBoundingClientRect().top <= 140) current = index;
		});
		// 捲到底時最後幾段可能到不了頂端，直接選最後一個
		if (window.innerHeight + window.scrollY >= document.body.scrollHeight - 2) current = targets.length - 1;
		links.forEach((link, index) => link.setAttribute('aria-current', String(index === current)));
	}

	if (targets.length > 0) {
		updateActive();
		window.addEventListener('scroll', updateActive, { passive: true });
	}
</script>
